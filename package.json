{
  "name": "tool-gtm-hubspot",
  "version": "1.0.0",
  "description": "MCP server: HubSpot CRM queries and Obsidian vault knowledge maps",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node_modules/.bin/tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test src/vault/summary.test.ts",
    "sync-deal-map": "tsx scripts/sync-deal-map.ts",
    "sync-all-deals": "tsx scripts/sync-all-deals.ts",
    "resync-existing-deals": "tsx scripts/resync-existing-vault-deals.ts",
    "migrate-deal-folder": "tsx scripts/migrate-deal-folder.ts",
    "smoke-deal-vault": "tsx scripts/smoke-deal-vault.ts",
    "discover-company": "tsx scripts/discover-company.ts",
    "check:throttle": "tsx scripts/throttle-cache-check.ts"
  },
  "keywords": ["mcp", "hubspot", "obsidian", "gtm"],
  "license": "ISC",
  "dependencies": {
    "@hubspot/api-client": "^13.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
